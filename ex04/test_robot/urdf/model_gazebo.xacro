<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. Плагин Joint State Publisher (чтобы робот не разваливался в RViz) -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
        </plugin>
    </gazebo>

    <!-- 2. Плагин Diff Drive (для управления колесами) -->
    <!-- У тебя в main xacro имена джоинтов: right_front_wheel_joint и left_front_wheel_joint
         Но в макросе wheel они создаются как ${name}_joint. 
         В leg_assembly ты вызываешь макрос wheel с именем ${side}_front_wheel.
         Значит итоговое имя: right_front_wheel_joint и left_front_wheel_joint. Всё верно. -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>left_front_wheel_joint</left_joint>
            <right_joint>right_front_wheel_joint</right_joint>
            <wheel_separation>0.4</wheel_separation>
            <wheel_radius>0.035</wheel_radius>
            <odom_publish_frequency>20</odom_publish_frequency>
            <topic>cmd_vel</topic>
            
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
        </plugin>
    </gazebo>

    <!-- 3. Лидар сенсор -->
    <gazebo reference="lidar_link">
        <material>Gazebo/White</material>
        
        <sensor name="lidar_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            
            <!-- Топик внутри Gazebo -->
            <topic>lidar/raw</topic>
            
            <update_rate>10</update_rate>
            
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1.0</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>
                
                <range>
                    <!-- Увеличил min до 0.15, чтобы не цеплял корпус -->
                    <min>0.15</min> 
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
                
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>
    
    <gazebo reference="camera_link">
        <sensor name="depth_camera" type="depth_camera">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>6</update_rate>
            <always_on>1</always_on>
            <topic>camera/depth</topic>
            <gz_frame_id>camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.51843645</horizontal_fov>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10</far>
                </clip>
                <lens>
                    <intrinsics>
                        <fx>421.61578369140625</fx>
                        <fy>421.61578369140625</fy>
                        <cx>422.2854309082031</cx>
                        <cy>236.57237243652344</cy>
                        <s>0</s>
                    </intrinsics>
                </lens>
            </camera>
        </sensor>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>1</always_on>
            <update_rate>100</update_rate> <!-- IMU обычно быстрый -->
            <visualize>true</visualize>
            <topic>imu/raw</topic> <!-- Топик внутри Gazebo -->
            <pose>0 0 0 0 0 0</pose>
        </sensor>
    </gazebo>
</robot>
